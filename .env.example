# Inside Docker Compose, DATABASE_URL, REDIS_URL and PROBLEMS_DIR are set by the Compose files;
# the values here are for running the tests and scripts on this machine.
DATABASE_URL=postgresql+psycopg://verdict:verdict@localhost:5432/verdict
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
PROBLEMS_DIR=/data/problems
# docker-compose.prod.yml sets this to true.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
LEASE_SECONDS=60
HEARTBEAT_SECONDS=15
MAX_ATTEMPTS=3
POLL_SECONDS=2
QUEUE_LIMIT=500
PYTHON_TIME_MULTIPLIER=2
# Group that owns /var/run/docker.sock on the host: 0 on Docker Desktop; on Linux, the output of
# `getent group docker | cut -d: -f3`.
DOCKER_GID=0
# Production only (docker-compose.prod.yml); both must be set. The database password should be
# URL-safe, for example `openssl rand -hex 24`. The domain is the name Caddy gets a certificate for,
# such as judge.example.edu (localhost works for trying production on one machine).
POSTGRES_PASSWORD=
VERDICT_DOMAIN=
