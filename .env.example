DATABASE_URL=postgresql+psycopg://verdict:verdict@localhost:5432/verdict
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
PROBLEMS_DIR=/data/problems
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
LEASE_SECONDS=60
HEARTBEAT_SECONDS=15
MAX_ATTEMPTS=3
POLL_SECONDS=2
QUEUE_LIMIT=500
PYTHON_TIME_MULTIPLIER=2
# Group that owns /var/run/docker.sock on the host: 0 on Docker Desktop, `getent group docker` on Linux.
DOCKER_GID=0
# Production only (docker-compose.prod.yml): the database password, which must be set, and the
# domain Caddy gets a certificate for. Use a URL-safe password, for example `openssl rand -hex 24`.
POSTGRES_PASSWORD=
VERDICT_DOMAIN=localhost
